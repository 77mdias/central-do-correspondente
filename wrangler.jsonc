{
  "$schema": "node_modules/wrangler/config-schema.json",
  // nome local de propósito: um deploy sem CLOUDFLARE_ENV=production cria outro Worker em vez de sobrescrever o de produção
  "name": "central-do-correspondente-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  // ids reais do Hyperdrive na fase 3 (deploy); no local a conexão vem de
  // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_<BINDING> (docs/SEGREDOS.md)
  "hyperdrive": [
    { "binding": "DB_APP", "id": "00000000000000000000000000000000" },
    { "binding": "DB_SYSTEM", "id": "00000000000000000000000000000001" }
  ],
  "vars": {
    "APP_URL": "http://localhost:3002",
    "EMAIL_REMETENTE": "Central do Correspondente <nao-responda@localhost>",
    // s3mock do compose (as chaves, quaisquer, vêm do CriptEnv development)
    "S3_ENDPOINT": "http://s3:9090",
    "S3_REGIAO": "us-east-1",
    "S3_BUCKET": "documentos"
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "EMAIL_API_URL", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY"] },
  "env": {
    // e2e: mesmo app na porta 3102 (CLOUDFLARE_ENV=e2e, playwright.config.ts); vars e bindings não são herdados
    "e2e": {
      "hyperdrive": [
        { "binding": "DB_APP", "id": "00000000000000000000000000000000" },
        { "binding": "DB_SYSTEM", "id": "00000000000000000000000000000001" }
      ],
      "vars": {
        "APP_URL": "http://localhost:3102",
        "EMAIL_REMETENTE": "Central do Correspondente <nao-responda@localhost>",
        "S3_ENDPOINT": "http://localhost:9093",
        "S3_REGIAO": "us-east-1",
        "S3_BUCKET": "documentos"
      },
      "secrets": { "required": ["BETTER_AUTH_SECRET", "EMAIL_API_URL", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY"] }
    },
    // produção: escolhida no build (pnpm deploy:producao); o nome bate com o Worker do painel
    "production": {
      "name": "central-do-correspondente",
      // Workers Logs (fase 3): o Worker só registra erros sem dados pessoais (worker/log.ts); a query string sai dos logs
      "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "enabled": true, "invocation_logs": true }, "redact_query_string": true },
      "hyperdrive": [
        // projeto Supabase em São Paulo (cc-db-app-sp e cc-db-system-sp, sem cache; D-37)
        { "binding": "DB_APP", "id": "3f8ef317bd3347bd9bc322e65bbc32a0" },
        { "binding": "DB_SYSTEM", "id": "c7735e8d027f487e8da7b7830cbc8552" }
      ],
      "vars": {
        // domínio ligado ao Worker pelo painel (aba Domains); o deploy não mexe em domínio que não está declarado aqui
        "APP_URL": "https://central-correspondente.wdias.tech",
        // subdomínio verificado na Resend (D-38); sem a verificação a Resend recusa o envio (HTTP 403)
        "EMAIL_REMETENTE": "Central do Correspondente <nao-responda@central-correspondente.wdias.tech>",
        // Supabase Storage pela API S3 (bucket privado; docs/SEGREDOS.md, "Anexos")
        "S3_ENDPOINT": "https://uxxpbjfshtwgdtcuhrbc.storage.supabase.co/storage/v1/s3",
        "S3_REGIAO": "sa-east-1", // a região do projeto Supabase (a assinatura S3 precisa bater)
        "S3_BUCKET": "documentos"
      },
      // sem BETTER_AUTH_SECRET o Better Auth cai numa chave padrão pública: o deploy tem que falhar.
      // EMAIL_API_KEY é a chave da Resend: sem ela não há confirmação de cadastro nem convite.
      // As chaves S3 do Supabase: sem elas não há anexos.
      "secrets": { "required": ["BETTER_AUTH_SECRET", "EMAIL_API_KEY", "S3_ACCESS_KEY_ID", "S3_SECRET_ACCESS_KEY"] },
      // rotina diária de anexos (RF-27): 6h UTC = 3h de Brasília
      "triggers": { "crons": ["0 6 * * *"] }
    }
  }
}
